# Optional; falls back to the Vercel host, then localhost
NEXT_PUBLIC_SITE_URL=

# Contact form and resume requests: "log" prints emails; "resend" (default) sends them
CONTACT_DELIVERY=log
# Resend API key; server only, never commit a real one
RESEND_API_KEY=
# Marc's inbox for contact messages and resume requests; npm run resume:pdf prints it in the PDF
CONTACT_TO_EMAIL=
# Optional sender; defaults to Portfolio contact <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Resume requests and rate limits: Upstash Redis from the Vercel Marketplace (server only)
# The Upstash dashboard's UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN work too
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Tests only: "memory" keeps requests in memory; it never runs on Vercel
RESUME_REQUEST_STORE=
